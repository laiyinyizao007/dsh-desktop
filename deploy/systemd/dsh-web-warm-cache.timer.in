[Unit]
Description=Refresh the edge cache with the DSH client bundles every ten minutes

[Timer]
# The bundles are content-addressed: a rebuilt bundle gets a new revision and
# a new URL, so the warm run has to happen again after a rebuild. The Harness
# restart that a rebuild causes is what usually invalidates them.
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
