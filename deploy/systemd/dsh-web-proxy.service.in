[Unit]
Description=Reverse proxy for the DSH Harness web UI (injects the live launch token)
Documentation=https://github.com/dataelement/dsh-desktop
# Deliberately not `Requires=dsh-web.service`: the proxy reads the Harness's
# launch token from the log on every request, so it survives a Harness
# restart on its own. Tying it with `Requires` would stop and restart the
# proxy whenever the Harness restarts, which drops live WebSocket clients
# and leaves the public URL answering 502 in the gap.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${USER}
Group=${GROUP}
WorkingDirectory=${REPO}
Environment=DSH_HOME=${DSH_HOME}
Environment=SHELL=/bin/sh
# The upstream Harness address. It must match the --host the Harness binds,
# and the Harness rejects a wildcard host.
Environment=DSH_UPSTREAM=http://${BIND}:${HARNESS_PORT}
Environment=DSH_HARNESS_LOG=${LOG_FILE}
ExecStart=${NODE} ${REPO}/scripts/dsh-web-proxy.mjs --port ${PROXY_PORT}
# `always`, not `on-failure`: the proxy is expected to exit cleanly on
# shutdown, and `on-failure` leaves the unit down in that case.
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
