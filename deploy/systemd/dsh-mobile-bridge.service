[Unit]
Description=DSH Desktop LAN mobile bridge (PIN-paired phone access)
Documentation=https://github.com/dataelement/dsh-desktop
# Deliberately not `Requires=dsh-web.service`: the bridge re-reads the
# Harness's launch token from the log on every exchange, so it survives a
# Harness restart on its own. Tying it with `Requires` would stop and restart
# the bridge whenever the Harness stops — and because a `systemctl stop` is an
# explicit stop, `Restart=always` would not bring it back: a single stop of
# the Harness would take the phone bridge down for good.
After=network-online.target dsh-web.service
Wants=network-online.target dsh-web.service

[Service]
Type=simple
User=averypi
Group=averypi
WorkingDirectory=/home/averypi/dsh-desktop
Environment=DSH_HOME=/home/averypi/.dsh
Environment=SHELL=/bin/sh
# The bridge talks to the Harness over the LAN address, not through the proxy.
Environment=NO_PROXY=127.0.0.1,localhost,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,100.64.0.0/10
Environment=no_proxy=127.0.0.1,localhost,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,100.64.0.0/10
Environment=DSH_HARNESS_LOG=/var/log/dsh-web.log
# --public-url is the fixed public address in front of this bridge; the
# pairing URL is published under it so the hostname does not change when the
# bridge restarts. Drop it to use the bridge's own LAN address.
ExecStart=/usr/bin/node /home/averypi/dsh-desktop/scripts/standalone-mobile-bridge.mjs
# `always`, not `on-failure`: the bridge is expected to exit cleanly on
# shutdown, and `on-failure` leaves the unit down in that case.
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
