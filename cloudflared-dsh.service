# Cloudflare Tunnel for the DSH Desktop web UI.
#
# Point the tunnel at the reverse proxy (43128), not at the Harness (43129):
# the proxy injects the Harness's rotating launch token, so the domain works
# as a plain bookmarkable URL and survives a Harness restart.
#
# The LAN-mobile bridge keeps its own port (43130) for the reduced phone UI.
#
# Run with:
#   cloudflared --no-autoupdate --config ~/.cloudflared/config-dsh.yml tunnel run dsh-desktop

tunnel: <tunnel-uuid>
credentials-file: /home/<user>/.cloudflared/<tunnel-uuid>.json
protocol: http2

ingress:
  - hostname: dsh.example.com
    service: http://127.0.0.1:43128
    originRequest:
      noTLSVerify: true
      connectTimeout: 10s
      tlsTimeout: 10s
      keepAliveConnections: 4
      keepAliveTimeout: 90s
  - service: http_status:404
