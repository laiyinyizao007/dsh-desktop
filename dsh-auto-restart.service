[Unit]
Description=Restart the DSH Harness when a client bundle changed after it started
Documentation=https://github.com/dataelement/dsh-desktop

[Service]
Type=oneshot
User=averypi
Group=averypi
WorkingDirectory=/home/averypi/dsh-desktop
Environment=DSH_HOME=/home/averypi/.dsh
Environment=DSH_HARNESS_SERVICE=dsh-web.service
Environment=DSH_PROXY_PORT=43128
ExecStart=/home/averypi/dsh-desktop/scripts/dsh-auto-restart.sh
